# ===== Copy to .env and fill in. NEVER commit .env. =====

NODE_ENV=development                 # development | test | production
PORT=5000

# --- MongoDB ---------------------------------------------------------------
# Local standalone:   mongodb://127.0.0.1:27017/pizza_delivery
# Local replica set (enables transactions): mongodb://127.0.0.1:27017/pizza_delivery?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/pizza_delivery
MONGODB_URI=mongodb://127.0.0.1:27017/pizza_delivery
# auto = use transactions when the server supports them, otherwise fall back (see README). off = never try.
MONGO_TRANSACTIONS=auto

# --- Frontend / CORS ---------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Extra comma-separated allowed origins (FRONTEND_URL is always allowed)
CORS_ORIGINS=
TRUST_PROXY=0                        # set to 1 behind one reverse proxy (Render, Railway, Nginx)

# --- Auth --------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque random values stored hashed in MongoDB (no JWT_REFRESH_SECRET needed).
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SECURE=false                  # must be true in production (HTTPS)
COOKIE_SAMESITE=lax                  # lax|strict for same-site; use "none" (+ COOKIE_SECURE=true) for cross-site SPA/API hosting

# --- Razorpay (TEST mode keys only: rzp_test_...) ------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (SMTP via Nodemailer) ----------------------------------------------
# Gmail example: smtp.gmail.com / 465 / your address / an App Password. Leave blank in dev for preview mode (nothing is sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pizza Delivery <no-reply@example.com>"

# --- Inventory alerts & scheduler ---------------------------------------------
ADMIN_EMAIL=admin@example.com        # low-stock alert recipient
LOW_STOCK_ALERT_ENABLED=true
LOW_STOCK_CHECK_SCHEDULE=*/15 * * * *
ENABLE_SCHEDULER=true                # run cron jobs in THIS process. Enable on exactly one instance.

# --- Business rules ------------------------------------------------------------
RESERVATION_MINUTES=15               # how long stock is held for an unpaid order
DELIVERY_FEE_PAISE=4000              # 4000 paise = INR 40.00
FREE_DELIVERY_ABOVE_PAISE=0          # 0 disables free delivery

# --- Rate limiting / logging ----------------------------------------------------
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info                       # debug | info | warn | error

# --- Seed script only (read by `npm run seed`, not by the server) -----------------
ADMIN_SEED_NAME=Store Admin
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
